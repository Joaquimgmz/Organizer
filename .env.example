# ---------------------------------------------------------------------------
# Routine Organizer — environment configuration
# Copy this file to `.env.local` and fill in what you need.
# The app runs fully without any of these; each one unlocks an extra feature.
# ---------------------------------------------------------------------------

# REQUIRED IN PRODUCTION — signs session cookies. Any long random string.
# Generate one:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
AUTH_SECRET=

# Where the local SQLite file lives when running without Turso. Defaults to
# ./data/routine.db. Ignored once TURSO_DATABASE_URL is set.
# DATABASE_PATH=./data/routine.db

# ---------------------------------------------------------------------------
# Database (required in production — e.g. Vercel)
# Local dev works with no setup: a plain SQLite file at DATABASE_PATH above.
# Deploying to a serverless host needs a real database instead, since the
# filesystem there is read-only/ephemeral. Turso (https://turso.tech) is a
# hosted, SQLite-compatible database with a generous free tier:
#   1. turso db create routine-organizer
#   2. turso db show routine-organizer --url        → TURSO_DATABASE_URL
#   3. turso db tokens create routine-organizer      → TURSO_AUTH_TOKEN
# ---------------------------------------------------------------------------
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Public base URL, used to build OAuth redirect URIs.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Fitbit integration (optional)
# Register an app at https://dev.fitbit.com/apps
#   OAuth 2.0 Application Type: Personal (needed for intraday heart rate)
#   Callback URL: http://localhost:3000/api/fitness/callback/fitbit
# ---------------------------------------------------------------------------
FITBIT_CLIENT_ID=
FITBIT_CLIENT_SECRET=

# ---------------------------------------------------------------------------
# Google Fit integration (optional)
# Create OAuth credentials at https://console.cloud.google.com/apis/credentials
#   Authorised redirect URI: http://localhost:3000/api/fitness/callback/google
# NOTE: Google is retiring the Fit REST API in favour of Health Connect.
#       Fitbit is the better-supported option today.
# ---------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
